<form action="/dashboard/places" method="POST">
  <div class="field">
    <label class="label" for="place-name">Place name</label>
    <div class="control">
      <input id="place-name" class="input" type="text" maxlength="100" placeholder="For example, Glendalough Spinc" name="name" required>
    </div>
  </div>
  <button class="button is-link" type="submit">Add place</button>
</form>
