{{#if places.length}}
  {{#each places}}
    <article class="box">
      <h2 class="title is-5">{{name}}</h2>
      {{#if difficulty}}<span class="tag is-info is-light mb-2">{{difficulty}}</span>{{/if}}
      {{#if distanceKm}}<span class="tag is-light mb-2">{{distanceKm}} km</span>{{/if}}  
      {{#if description}}<p class="mb-3">{{description}}</p>{{/if}}
      <div class="buttons">
        <a href="/place/{{_id}}" class="button is-light">View place</a>
        <form action="/dashboard/places/{{_id}}/delete" method="POST">
          <button class="button is-danger is-light" type="submit">Remove</button>
        </form>
      </div>
    </article>
  {{/each}}
{{else}}
  <div class="notification is-light">You have not added a place yet</div>
{{/if}}
