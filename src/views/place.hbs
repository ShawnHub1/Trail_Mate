{{> menu active="dashboard"}}
<section class="section">
  <a href="/dashboard">&larr; Back to places</a>
  <h1 class="title mt-4">{{place.name}}</h1>
  {{#if place.difficulty}}<p class="mb-2"><strong>Difficulty:</strong> {{place.difficulty}}</p>{{/if}}
  {{#if place.distanceKm}}<p class="mb-2"><strong>Distance:</strong> {{place.distanceKm}} km</p>{{/if}}  
 {{#if place.description}}<p class="content">{{place.description}}</p>{{else}}<p class="has-text-grey">No description has been added.</p>{{/if}}
  {{#if place.latitude}}
    <p class="mt-4"><strong>Coordinates:</strong> {{place.latitude}}, {{place.longitude}}</p>
    <p><a class="button is-light mt-2" href="https://www.openstreetmap.org/?mlat={{place.latitude}}&mlon={{place.longitude}}#map=15/{{place.latitude}}/{{place.longitude}}" target="_blank" rel="noopener noreferrer">View on OpenStreetMap</a></p>
  {{else}}
    <p class="mt-4 has-text-grey">No coordinates have been added.</p>
  {{/if}}
  <div class="buttons mt-4">
    <a class="button is-link" href="/dashboard/places/{{place._id}}/edit">Edit place</a>
    <a href="/api/places/{{place._id}}.json">View place JSON</a>
  </div>
</section>
